# Backend database settings
DB_URL=jdbc:mysql://localhost:3306/lockerflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=lockerflow
DB_PASSWORD=change-me

# JWT access-token settings. Replace the secret placeholder with Base64 for at least 32 random bytes.
JWT_SECRET_BASE64=replace-with-base64-encoded-random-secret
JWT_ISSUER=lockerflow
JWT_ACCESS_TOKEN_TTL=PT30M

# Expiration scheduler settings (ISO-8601 durations)
EXPIRATION_SCHEDULING_ENABLED=true
EXPIRATION_FIXED_DELAY=PT15M
EXPIRATION_INITIAL_DELAY=PT1M

# Frontend API base path used through the Vite development proxy
VITE_API_BASE_URL=/api
